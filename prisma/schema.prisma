generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model addresses {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id        BigInt    @db.UnsignedBigInt
  label          String?   @db.VarChar(255)
  recipient_name String    @db.VarChar(255)
  phone          String    @db.VarChar(255)
  address_line   String    @db.VarChar(255)
  city           String    @db.VarChar(255)
  area           String?   @db.VarChar(255)
  postal_code    String?   @db.VarChar(255)
  is_default     Boolean   @default(false)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "addresses_user_id_foreign")

  @@index([user_id], map: "addresses_user_id_foreign")
}

model audit_logs {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id        BigInt?   @db.UnsignedBigInt
  user_name      String?   @db.VarChar(255)
  event          String    @db.VarChar(20)
  auditable_type String    @db.VarChar(255)
  auditable_id   String?   @db.VarChar(255)
  record_label   String?   @db.VarChar(255)
  changes        String?   @db.LongText
  url            String?   @db.VarChar(500)
  ip_address     String?   @db.VarChar(45)
  user_agent     String?   @db.Text
  created_at     DateTime? @db.Timestamp(0)
  users          users?    @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "audit_logs_user_id_foreign")

  @@index([auditable_type, auditable_id], map: "audit_logs_auditable_type_auditable_id_index")
  @@index([created_at], map: "audit_logs_created_at_index")
  @@index([event], map: "audit_logs_event_index")
  @@index([user_id], map: "audit_logs_user_id_index")
}

model banners {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title       String?   @db.VarChar(255)
  subtitle    String?   @db.VarChar(255)
  image_path  String    @db.VarChar(255)
  video_path  String?   @db.VarChar(255)
  button_text String?   @db.VarChar(255)
  button_link String?   @db.VarChar(255)
  position    String    @default("hero") @db.VarChar(255)
  sort_order  Int       @default(0)
  is_active   Boolean   @default(true)
  starts_at   DateTime? @db.Timestamp(0)
  ends_at     DateTime? @db.Timestamp(0)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model brands {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  name             String             @db.VarChar(255)
  slug             String             @unique(map: "brands_slug_unique") @db.VarChar(255)
  logo_path        String?            @db.VarChar(255)
  is_featured      Boolean            @default(true)
  sort_order       Int                @default(0) @db.UnsignedInt
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  website_products website_products[]
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration Int

  @@index([expiration], map: "cache_expiration_index")
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int

  @@index([expiration], map: "cache_locks_expiration_index")
}

model consultancy_requests {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name          String    @db.VarChar(255)
  phone         String    @db.VarChar(255)
  email         String?   @db.VarChar(255)
  message       String?   @db.Text
  vehicle_brand String?   @db.VarChar(255)
  vehicle_model String?   @db.VarChar(255)
  status        String    @default("pending") @db.VarChar(255)
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
}

model cta_banners {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title            String    @db.VarChar(255)
  subtitle         String?   @db.Text
  button_text      String?   @db.VarChar(255)
  button_link      String?   @db.VarChar(255)
  button_two_text  String?   @db.VarChar(255)
  button_two_link  String?   @db.VarChar(255)
  background_color String    @default("#1565C0") @db.VarChar(255)
  image_path       String?   @db.VarChar(255)
  position         String    @default("home") @db.VarChar(255)
  is_active        Boolean   @default(true)
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
}

model emi_plans {
  id                     BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  bank_name              String?   @db.VarChar(255)
  tenure_months          Int       @db.UnsignedSmallInt
  interest_rate          Decimal   @default(0.00) @db.Decimal(5, 2)
  processing_fee_percent Decimal   @default(0.00) @db.Decimal(5, 2)
  min_order_amount       Decimal   @default(0.00) @db.Decimal(10, 2)
  is_active              Boolean   @default(true)
  sort_order             Int       @default(0) @db.UnsignedInt
  created_at             DateTime? @db.Timestamp(0)
  updated_at             DateTime? @db.Timestamp(0)
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model feature_cards {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  icon        String    @db.VarChar(255)
  title       String    @db.VarChar(255)
  description String    @db.Text
  sort_order  Int       @default(0)
  is_active   Boolean   @default(true)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model homepage_sections {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  section_key  String    @unique(map: "homepage_sections_section_key_unique") @db.VarChar(255)
  section_type String    @default("builtin") @db.VarChar(255)
  title        String?   @db.VarChar(255)
  subtitle     String?   @db.Text
  is_visible   Boolean   @default(true)
  sort_order   Int       @default(0)
  extra_data   String?   @db.LongText
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String  @db.LongText
  options        String? @db.MediumText
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  queue        String @db.VarChar(255)
  payload      String @db.LongText
  attempts     Int    @db.UnsignedTinyInt
  reserved_at  Int?   @db.UnsignedInt
  available_at Int    @db.UnsignedInt
  created_at   Int    @db.UnsignedInt

  @@index([queue], map: "jobs_queue_index")
}

model media {
  id                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  model_type            String    @db.VarChar(255)
  model_id              BigInt    @db.UnsignedBigInt
  uuid                  String?   @unique(map: "media_uuid_unique") @db.Char(36)
  collection_name       String    @db.VarChar(255)
  name                  String    @db.VarChar(255)
  file_name             String    @db.VarChar(255)
  mime_type             String?   @db.VarChar(255)
  disk                  String    @db.VarChar(255)
  conversions_disk      String?   @db.VarChar(255)
  size                  BigInt    @db.UnsignedBigInt
  manipulations         String    @db.LongText
  custom_properties     String    @db.LongText
  generated_conversions String    @db.LongText
  responsive_images     String    @db.LongText
  order_column          Int?      @db.UnsignedInt
  created_at            DateTime? @db.Timestamp(0)
  updated_at            DateTime? @db.Timestamp(0)

  @@index([model_type, model_id], map: "media_model_type_model_id_index")
  @@index([order_column], map: "media_order_column_index")
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String @db.VarChar(255)
  batch     Int
}

model model_has_permissions {
  permission_id BigInt      @db.UnsignedBigInt
  model_type    String      @db.VarChar(255)
  model_id      BigInt      @db.UnsignedBigInt
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "model_has_permissions_permission_id_foreign")

  @@id([permission_id, model_id, model_type])
  @@index([model_id, model_type], map: "model_has_permissions_model_id_model_type_index")
}

model model_has_roles {
  role_id    BigInt @db.UnsignedBigInt
  model_type String @db.VarChar(255)
  model_id   BigInt @db.UnsignedBigInt
  roles      roles  @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "model_has_roles_role_id_foreign")

  @@id([role_id, model_id, model_type])
  @@index([model_id, model_type], map: "model_has_roles_model_id_model_type_index")
}

model nav_menus {
  id              BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  label           String      @db.VarChar(255)
  link            String?     @db.VarChar(255)
  parent_id       BigInt?     @db.UnsignedBigInt
  menu_group      String      @default("main") @db.VarChar(255)
  icon            String?     @db.VarChar(255)
  sort_order      Int         @default(0)
  is_active       Boolean     @default(true)
  open_in_new_tab Boolean     @default(false)
  created_at      DateTime?   @db.Timestamp(0)
  updated_at      DateTime?   @db.Timestamp(0)
  nav_menus       nav_menus?  @relation("nav_menusTonav_menus", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "nav_menus_parent_id_foreign")
  other_nav_menus nav_menus[] @relation("nav_menusTonav_menus")

  @@index([parent_id], map: "nav_menus_parent_id_foreign")
}

model order_items {
  id                 BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  order_id           BigInt            @db.UnsignedBigInt
  pos_product_id     BigInt?           @db.UnsignedBigInt
  website_product_id BigInt?           @db.UnsignedBigInt
  product_source     String            @default("pos") @db.VarChar(255)
  product_name       String            @db.VarChar(255)
  product_sku        String            @db.VarChar(255)
  quantity           Int
  unit_price         Decimal           @db.Decimal(10, 2)
  total_price        Decimal           @db.Decimal(10, 2)
  created_at         DateTime?         @db.Timestamp(0)
  updated_at         DateTime?         @db.Timestamp(0)
  orders             orders            @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "order_items_order_id_foreign")
  pos_products       pos_products?     @relation(fields: [pos_product_id], references: [id], onUpdate: Restrict, map: "order_items_pos_product_id_foreign")
  website_products   website_products? @relation(fields: [website_product_id], references: [id], onUpdate: Restrict, map: "order_items_website_product_id_foreign")

  @@index([order_id], map: "order_items_order_id_foreign")
  @@index([pos_product_id], map: "order_items_pos_product_id_foreign")
  @@index([website_product_id], map: "order_items_website_product_id_foreign")
}

model orders {
  id                       BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  order_number             String        @unique(map: "orders_order_number_unique") @db.VarChar(255)
  user_id                  BigInt?       @db.UnsignedBigInt
  customer_name            String        @db.VarChar(255)
  customer_email           String        @db.VarChar(255)
  customer_phone           String        @db.VarChar(255)
  shipping_address         String        @db.Text
  city                     String        @db.VarChar(255)
  subtotal                 Decimal       @db.Decimal(10, 2)
  shipping_charge          Decimal       @default(0.00) @db.Decimal(10, 2)
  discount                 Decimal       @default(0.00) @db.Decimal(10, 2)
  tax                      Decimal       @default(0.00) @db.Decimal(10, 2)
  total                    Decimal       @db.Decimal(10, 2)
  payment_method           String        @default("cod") @db.VarChar(255)
  payment_status           String        @default("pending") @db.VarChar(255)
  transaction_id           String?       @db.VarChar(255)
  payment_gateway_response String?       @db.LongText
  order_status             String        @default("pending") @db.VarChar(255)
  courier_provider         String?       @db.VarChar(255)
  courier_consignment_id   String?       @db.VarChar(255)
  courier_tracking_code    String?       @db.VarChar(255)
  courier_status           String?       @db.VarChar(255)
  courier_sent_at          DateTime?     @db.Timestamp(0)
  notes                    String?       @db.Text
  tracking_number          String?       @db.VarChar(255)
  created_at               DateTime?     @db.Timestamp(0)
  updated_at               DateTime?     @db.Timestamp(0)
  order_items              order_items[]
  users                    users?        @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "orders_user_id_foreign")

  @@index([created_at], map: "orders_created_at_index")
  @@index([order_number], map: "orders_order_number_index")
  @@index([order_status], map: "orders_order_status_index")
  @@index([user_id], map: "orders_user_id_foreign")
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model payment_methods {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code        String    @unique(map: "payment_methods_code_unique") @db.VarChar(255)
  label       String    @db.VarChar(255)
  description String?   @db.VarChar(255)
  sort_order  Int       @default(0)
  is_active   Boolean   @default(true)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model permissions {
  id                    BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  name                  String                  @db.VarChar(255)
  guard_name            String                  @db.VarChar(255)
  created_at            DateTime?               @db.Timestamp(0)
  updated_at            DateTime?               @db.Timestamp(0)
  model_has_permissions model_has_permissions[]
  role_has_permissions  role_has_permissions[]

  @@unique([name, guard_name], map: "permissions_name_guard_name_unique")
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenable_type String    @db.VarChar(255)
  tokenable_id   BigInt    @db.UnsignedBigInt
  name           String    @db.Text
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?   @db.Text
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([expires_at], map: "personal_access_tokens_expires_at_index")
  @@index([tokenable_type, tokenable_id], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
}

model pos_brands {
  id           BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  pos_brand_id String         @unique(map: "pos_brands_pos_brand_id_unique") @db.VarChar(255)
  name         String         @db.VarChar(255)
  slug         String         @unique(map: "pos_brands_slug_unique") @db.VarChar(255)
  created_at   DateTime?      @db.Timestamp(0)
  updated_at   DateTime?      @db.Timestamp(0)
  pos_products pos_products[]
}

model pos_categories {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  pos_category_id String         @unique(map: "pos_categories_pos_category_id_unique") @db.VarChar(255)
  name            String         @db.VarChar(255)
  slug            String         @unique(map: "pos_categories_slug_unique") @db.VarChar(255)
  created_at      DateTime?      @db.Timestamp(0)
  updated_at      DateTime?      @db.Timestamp(0)
  pos_products    pos_products[]
}

model pos_products {
  id                         BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  pos_id                     String                       @unique(map: "pos_products_pos_id_unique") @db.VarChar(255)
  sku                        String                       @unique(map: "pos_products_sku_unique") @db.VarChar(255)
  name                       String                       @db.VarChar(255)
  barcode                    String?                      @db.VarChar(255)
  price                      Decimal                      @db.Decimal(10, 2)
  cost_price                 Decimal?                     @db.Decimal(10, 2)
  sale_price                 Decimal?                     @db.Decimal(10, 2)
  stock_quantity             Int                          @default(0)
  unit                       String?                      @db.VarChar(255)
  pos_category_id            BigInt?                      @db.UnsignedBigInt
  pos_brand_id               BigInt?                      @db.UnsignedBigInt
  is_active                  Boolean                      @default(true)
  pos_synced_at              DateTime?                    @db.Timestamp(0)
  created_at                 DateTime?                    @db.Timestamp(0)
  updated_at                 DateTime?                    @db.Timestamp(0)
  order_items                order_items[]
  pos_brands                 pos_brands?                  @relation(fields: [pos_brand_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "pos_products_pos_brand_id_foreign")
  pos_categories             pos_categories?              @relation(fields: [pos_category_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "pos_products_pos_category_id_foreign")
  product_details            product_details?
  product_images             product_images[]
  product_website_categories product_website_categories[]

  @@index([is_active], map: "pos_products_is_active_index")
  @@index([pos_brand_id], map: "pos_products_pos_brand_id_foreign")
  @@index([pos_category_id], map: "pos_products_pos_category_id_foreign")
  @@index([pos_id], map: "pos_products_pos_id_index")
}

model product_details {
  id                 BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  pos_product_id     BigInt       @unique(map: "product_details_pos_product_id_unique") @db.UnsignedBigInt
  slug               String       @unique(map: "product_details_slug_unique") @db.VarChar(255)
  short_description  String?      @db.Text
  description        String?      @db.LongText
  meta_title         String?      @db.VarChar(255)
  meta_description   String?      @db.Text
  meta_keywords      String?      @db.VarChar(255)
  compatible_brands  String?      @db.LongText
  compatible_models  String?      @db.LongText
  compatible_years   String?      @db.LongText
  compatible_engines String?      @db.LongText
  specifications     String?      @db.LongText
  warranty           String?      @db.VarChar(255)
  weight             String?      @db.VarChar(255)
  dimensions         String?      @db.VarChar(255)
  country_of_origin  String?      @db.VarChar(255)
  oem_number         String?      @db.VarChar(255)
  tags               String?      @db.LongText
  is_featured        Boolean      @default(false)
  is_published       Boolean      @default(false)
  sort_order         Int          @default(0)
  created_at         DateTime?    @db.Timestamp(0)
  updated_at         DateTime?    @db.Timestamp(0)
  pos_products       pos_products @relation(fields: [pos_product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "product_details_pos_product_id_foreign")

  @@index([is_featured], map: "product_details_is_featured_index")
  @@index([is_published], map: "product_details_is_published_index")
  @@index([slug], map: "product_details_slug_index")
}

model product_images {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  pos_product_id BigInt       @db.UnsignedBigInt
  image_path     String       @db.VarChar(255)
  alt_text       String?      @db.VarChar(255)
  is_primary     Boolean      @default(false)
  sort_order     Int          @default(0)
  created_at     DateTime?    @db.Timestamp(0)
  updated_at     DateTime?    @db.Timestamp(0)
  pos_products   pos_products @relation(fields: [pos_product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "product_images_pos_product_id_foreign")

  @@index([pos_product_id], map: "product_images_pos_product_id_foreign")
}

model product_website_categories {
  pos_product_id      BigInt             @db.UnsignedBigInt
  website_category_id BigInt             @db.UnsignedBigInt
  pos_products        pos_products       @relation(fields: [pos_product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "product_website_categories_pos_product_id_foreign")
  website_categories  website_categories @relation(fields: [website_category_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "product_website_categories_website_category_id_foreign")

  @@id([pos_product_id, website_category_id])
  @@index([website_category_id], map: "product_website_categories_website_category_id_index")
}

model reviews {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id        BigInt    @db.UnsignedBigInt
  product_id     BigInt    @db.UnsignedBigInt
  product_source String    @default("pos") @db.VarChar(255)
  rating         Int       @db.UnsignedTinyInt
  title          String?   @db.VarChar(255)
  comment        String?   @db.Text
  is_approved    Boolean   @default(true)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "reviews_user_id_foreign")

  @@unique([user_id, product_id, product_source], map: "reviews_user_id_product_id_product_source_unique")
  @@index([product_id, product_source], map: "reviews_product_id_product_source_index")
}

model role_has_permissions {
  permission_id BigInt      @db.UnsignedBigInt
  role_id       BigInt      @db.UnsignedBigInt
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "role_has_permissions_permission_id_foreign")
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "role_has_permissions_role_id_foreign")

  @@id([permission_id, role_id])
  @@index([role_id], map: "role_has_permissions_role_id_foreign")
}

model roles {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  name                 String                 @db.VarChar(255)
  guard_name           String                 @db.VarChar(255)
  created_at           DateTime?              @db.Timestamp(0)
  updated_at           DateTime?              @db.Timestamp(0)
  model_has_roles      model_has_roles[]
  role_has_permissions role_has_permissions[]

  @@unique([name, guard_name], map: "roles_name_guard_name_unique")
}

model service_bookings {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  service_id  BigInt?   @db.UnsignedBigInt
  name        String    @db.VarChar(255)
  email       String    @db.VarChar(255)
  phone       String    @db.VarChar(255)
  description String?   @db.Text
  status      String    @default("pending") @db.VarChar(255)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  services    services? @relation(fields: [service_id], references: [id], onUpdate: Restrict, map: "service_bookings_service_id_foreign")

  @@index([service_id], map: "service_bookings_service_id_foreign")
  @@index([status], map: "service_bookings_status_index")
}

model services {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  title            String             @db.VarChar(255)
  description      String?            @db.Text
  price            Decimal?           @db.Decimal(10, 2)
  image_path       String?            @db.VarChar(255)
  sort_order       Int                @default(0)
  is_active        Boolean            @default(true)
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  service_bookings service_bookings[]
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt? @db.UnsignedBigInt
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model settings {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  key        String    @unique(map: "settings_key_unique") @db.VarChar(255)
  value      String?   @db.LongText
  group      String    @default("general") @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model shipping_methods {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  label          String    @db.VarChar(255)
  description    String?   @db.VarChar(255)
  price          Decimal   @default(0.00) @db.Decimal(10, 2)
  estimated_days String?   @db.VarChar(255)
  icon           String?   @db.VarChar(255)
  sort_order     Int       @default(0)
  is_active      Boolean   @default(true)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
}

model site_stats {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  label      String    @db.VarChar(255)
  value      String    @db.VarChar(255)
  icon       String?   @db.VarChar(255)
  sort_order Int       @default(0)
  is_active  Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model store_locations {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name         String    @db.VarChar(255)
  branch_type  String    @db.VarChar(255)
  address      String    @db.Text
  city         String    @db.VarChar(255)
  phone        String?   @db.VarChar(255)
  latitude     Decimal?  @db.Decimal(10, 7)
  longitude    Decimal?  @db.Decimal(10, 7)
  services     String?   @db.LongText
  opening_time String?   @db.VarChar(255)
  closing_time String?   @db.VarChar(255)
  off_days     String?   @db.LongText
  is_active    Boolean   @default(true)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
}

model testimonials {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customer_name  String    @db.VarChar(255)
  customer_title String?   @db.VarChar(255)
  avatar_path    String?   @db.VarChar(255)
  review         String    @db.Text
  rating         Int       @default(5) @db.UnsignedTinyInt
  is_active      Boolean   @default(true)
  sort_order     Int       @default(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
}

model users {
  id                   BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  name                 String            @db.VarChar(255)
  email                String            @unique(map: "users_email_unique") @db.VarChar(255)
  phone                String?           @db.VarChar(255)
  avatar               String?           @db.VarChar(255)
  address              String?           @db.VarChar(255)
  city                 String?           @db.VarChar(255)
  notify_order_updates Boolean           @default(true)
  notify_marketing     Boolean           @default(false)
  notify_restock       Boolean           @default(false)
  username             String?           @unique(map: "users_username_unique") @db.VarChar(255)
  email_verified_at    DateTime?         @db.Timestamp(0)
  password             String            @db.VarChar(255)
  google_id            String?           @unique(map: "users_google_id_unique") @db.VarChar(255)
  facebook_id          String?           @unique(map: "users_facebook_id_unique") @db.VarChar(255)
  remember_token       String?           @db.VarChar(100)
  created_at           DateTime?         @db.Timestamp(0)
  updated_at           DateTime?         @db.Timestamp(0)
  addresses            addresses[]
  audit_logs           audit_logs[]
  orders               orders[]
  reviews              reviews[]
  vehicle_garages      vehicle_garages[]
  wishlists            wishlists[]
}

model vehicle_brands {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  name            String            @db.VarChar(255)
  slug            String            @unique(map: "vehicle_brands_slug_unique") @db.VarChar(255)
  vehicle_type    String            @default("car") @db.VarChar(255)
  logo_path       String?           @db.VarChar(255)
  is_active       Boolean           @default(true)
  sort_order      Int               @default(0)
  created_at      DateTime?         @db.Timestamp(0)
  updated_at      DateTime?         @db.Timestamp(0)
  vehicle_garages vehicle_garages[]
  vehicle_models  vehicle_models[]

  @@index([vehicle_type], map: "vehicle_brands_vehicle_type_index")
}

model vehicle_engines {
  id               BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  vehicle_model_id BigInt            @db.UnsignedBigInt
  name             String            @db.VarChar(255)
  year_from        String?           @db.VarChar(255)
  year_to          String?           @db.VarChar(255)
  is_active        Boolean           @default(true)
  created_at       DateTime?         @db.Timestamp(0)
  updated_at       DateTime?         @db.Timestamp(0)
  vehicle_models   vehicle_models    @relation(fields: [vehicle_model_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "vehicle_engines_vehicle_model_id_foreign")
  vehicle_garages  vehicle_garages[]

  @@index([vehicle_model_id], map: "vehicle_engines_vehicle_model_id_foreign")
}

model vehicle_garages {
  id                BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  user_id           BigInt           @db.UnsignedBigInt
  vehicle_type      String           @default("car") @db.VarChar(255)
  vehicle_brand_id  BigInt?          @db.UnsignedBigInt
  vehicle_model_id  BigInt?          @db.UnsignedBigInt
  vehicle_engine_id BigInt?          @db.UnsignedBigInt
  year              String?          @db.VarChar(255)
  nickname          String?          @db.VarChar(255)
  is_default        Boolean          @default(false)
  created_at        DateTime?        @db.Timestamp(0)
  updated_at        DateTime?        @db.Timestamp(0)
  users             users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "vehicle_garages_user_id_foreign")
  vehicle_brands    vehicle_brands?  @relation(fields: [vehicle_brand_id], references: [id], onUpdate: Restrict, map: "vehicle_garages_vehicle_brand_id_foreign")
  vehicle_engines   vehicle_engines? @relation(fields: [vehicle_engine_id], references: [id], onUpdate: Restrict, map: "vehicle_garages_vehicle_engine_id_foreign")
  vehicle_models    vehicle_models?  @relation(fields: [vehicle_model_id], references: [id], onUpdate: Restrict, map: "vehicle_garages_vehicle_model_id_foreign")

  @@index([user_id], map: "vehicle_garages_user_id_foreign")
  @@index([vehicle_brand_id], map: "vehicle_garages_vehicle_brand_id_foreign")
  @@index([vehicle_engine_id], map: "vehicle_garages_vehicle_engine_id_foreign")
  @@index([vehicle_model_id], map: "vehicle_garages_vehicle_model_id_foreign")
}

model vehicle_models {
  id               BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  vehicle_brand_id BigInt            @db.UnsignedBigInt
  name             String            @db.VarChar(255)
  slug             String            @db.VarChar(255)
  image_path       String?           @db.VarChar(255)
  is_active        Boolean           @default(true)
  created_at       DateTime?         @db.Timestamp(0)
  updated_at       DateTime?         @db.Timestamp(0)
  vehicle_engines  vehicle_engines[]
  vehicle_garages  vehicle_garages[]
  vehicle_brands   vehicle_brands    @relation(fields: [vehicle_brand_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "vehicle_models_vehicle_brand_id_foreign")

  @@unique([vehicle_brand_id, slug], map: "vehicle_models_vehicle_brand_id_slug_unique")
}

model website_categories {
  id                         BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  name                       String                       @db.VarChar(255)
  slug                       String                       @unique(map: "website_categories_slug_unique") @db.VarChar(255)
  vehicle_type               String                       @default("car") @db.VarChar(255)
  description                String?                      @db.Text
  image_path                 String?                      @db.VarChar(255)
  icon                       String?                      @db.VarChar(255)
  parent_id                  BigInt?                      @db.UnsignedBigInt
  sort_order                 Int                          @default(0)
  is_active                  Boolean                      @default(true)
  show_in_nav                Boolean                      @default(false)
  created_at                 DateTime?                    @db.Timestamp(0)
  updated_at                 DateTime?                    @db.Timestamp(0)
  product_website_categories product_website_categories[]
  website_categories         website_categories?          @relation("website_categoriesTowebsite_categories", fields: [parent_id], references: [id], onUpdate: Restrict, map: "website_categories_parent_id_foreign")
  other_website_categories   website_categories[]         @relation("website_categoriesTowebsite_categories")
  website_product_categories website_product_categories[]

  @@index([is_active], map: "website_categories_is_active_index")
  @@index([parent_id], map: "website_categories_parent_id_foreign")
  @@index([show_in_nav], map: "website_categories_show_in_nav_index")
  @@index([sort_order], map: "website_categories_sort_order_index")
  @@index([vehicle_type], map: "website_categories_vehicle_type_index")
}

model website_product_categories {
  website_product_id  BigInt             @db.UnsignedBigInt
  website_category_id BigInt             @db.UnsignedBigInt
  website_categories  website_categories @relation(fields: [website_category_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "website_product_categories_website_category_id_foreign")
  website_products    website_products   @relation(fields: [website_product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "website_product_categories_website_product_id_foreign")

  @@id([website_product_id, website_category_id])
  @@index([website_category_id], map: "website_product_categories_website_category_id_index")
}

model website_product_images {
  id                 BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  website_product_id BigInt           @db.UnsignedBigInt
  image_path         String           @db.VarChar(255)
  alt_text           String?          @db.VarChar(255)
  is_primary         Boolean          @default(false)
  sort_order         Int              @default(0)
  created_at         DateTime?        @db.Timestamp(0)
  updated_at         DateTime?        @db.Timestamp(0)
  website_products   website_products @relation(fields: [website_product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "website_product_images_website_product_id_foreign")

  @@index([website_product_id], map: "website_product_images_website_product_id_foreign")
}

model website_products {
  id                         BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  sku                        String                       @unique(map: "website_products_sku_unique") @db.VarChar(255)
  name                       String                       @db.VarChar(255)
  barcode                    String?                      @db.VarChar(255)
  price                      Decimal?                     @db.Decimal(10, 2)
  sale_price                 Decimal?                     @db.Decimal(10, 2)
  stock_quantity             Int                          @default(0)
  unit                       String?                      @db.VarChar(255)
  brand_name                 String?                      @db.VarChar(255)
  brand_id                   BigInt?                      @db.UnsignedBigInt
  is_active                  Boolean                      @default(true)
  slug                       String                       @unique(map: "website_products_slug_unique") @db.VarChar(255)
  short_description          String?                      @db.Text
  description                String?                      @db.LongText
  meta_title                 String?                      @db.VarChar(255)
  meta_description           String?                      @db.Text
  meta_keywords              String?                      @db.VarChar(255)
  compatible_brands          String?                      @db.LongText
  compatible_models          String?                      @db.LongText
  compatible_years           String?                      @db.LongText
  compatible_engines         String?                      @db.LongText
  specifications             String?                      @db.LongText
  warranty                   String?                      @db.VarChar(255)
  weight                     String?                      @db.VarChar(255)
  dimensions                 String?                      @db.VarChar(255)
  country_of_origin          String?                      @db.VarChar(255)
  oem_number                 String?                      @db.VarChar(255)
  tags                       String?                      @db.LongText
  is_featured                Boolean                      @default(false)
  is_published               Boolean                      @default(false)
  sort_order                 Int                          @default(0)
  created_at                 DateTime?                    @db.Timestamp(0)
  updated_at                 DateTime?                    @db.Timestamp(0)
  order_items                order_items[]
  website_product_categories website_product_categories[]
  website_product_images     website_product_images[]
  brands                     brands?                      @relation(fields: [brand_id], references: [id], onUpdate: Restrict, map: "website_products_brand_id_foreign")

  @@index([brand_id], map: "website_products_brand_id_foreign")
  @@index([is_active], map: "website_products_is_active_index")
  @@index([is_published], map: "website_products_is_published_index")
}

model wishlists {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id        BigInt    @db.UnsignedBigInt
  product_id     BigInt    @db.UnsignedBigInt
  product_source String    @default("pos") @db.VarChar(255)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "wishlists_user_id_foreign")

  @@unique([user_id, product_id, product_source], map: "wishlists_user_id_product_id_product_source_unique")
}
